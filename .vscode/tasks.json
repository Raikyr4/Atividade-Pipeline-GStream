{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GStreamer: compilar",
            "type": "process",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/compilar.ps1"],
            "problemMatcher": "$gcc",
            "group": "build"
        },
        {
            "label": "GStreamer: executar",
            "type": "process",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/executar.ps1"],
            "problemMatcher": "$gcc"
        },
        {
            "label": "GStreamer: testar",
            "type": "process",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/testar.ps1"],
            "problemMatcher": "$gcc",
            "group": "test"
        }
    ]
}
